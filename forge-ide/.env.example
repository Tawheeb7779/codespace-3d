# Public client variables (bundled into the browser — never put secrets here).
# Copy this file to .env.local and fill in your own Supabase project to
# enable cloud accounts, teams, presence, and the AI agent. Without these,
# Forge IDE runs in local-only mode (see README).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER put these in this file or any VITE_-prefixed
# variable. They are set as Supabase Edge Function secrets instead:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set AI_KEY_ENCRYPTION_SECRET=$(openssl rand -base64 32)
#
# SUPABASE_URL and SUPABASE_ANON_KEY are auto-provided to Edge Functions by
# the Supabase runtime; you don't need to set them yourself.
# ---------------------------------------------------------------------------
